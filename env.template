# ========== 必須 ==========

# バックエンド API URL（nginx 経由ポート 80）
API_URL=http://localhost:3000

# NextAuth シークレット（`openssl rand -base64 32` などで生成）
AUTH_SECRET=

# Google OAuth クライアント ID / シークレット
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# クライアント識別シークレット（バックエンドと共有する固定値）
CLIENT_SECRET=

# Google Maps JavaScript API キー
GOOGLE_MAP_API_KEY=

# ========== 任意 ==========

# PaizaIO のコード実行 API キー（未設定時は "guest" にフォールバック）
PAIZAIO_API_KEY=

# Google Analytics 測定 ID（未設定時は GA タグを埋め込まない）
NEXT_PUBLIC_GOOGLE_ANALYTICS_ID=

# Google Search Console サイト所有権確認メタタグ
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# ========== Middleware ガード（Bot 対策・レート制限） ==========

# ガードの動作モード
#   off     … 何もしない（未設定・不正値もこれと同じ扱い。デフォルト）
#   shadow  … 判定とカウントのみ行い、遮断はせず x-guard-* ヘッダーで結果を返す
#   enforce … 悪性 Bot を 403、レート超過を 429 で遮断する
# ロールバックはこの値を off に戻すだけでよい（コード変更・再デプロイ不要）
GUARD_MODE=off

# レート制限のカウンタを保持する Upstash Redis（Edge 対応の REST API）
# Vercel の Upstash 統合が注入する変数名をそのまま使う。Upstash の
# コンソールでは UPSTASH_REDIS_REST_URL / _TOKEN という名前でも表示されるが、
# 値は同じもの。REDIS_URL（rediss://... 形式）は使わない。Edge Runtime は
# TCP ソケットを開けないため、HTTP ベースの REST API 一択になる。
#
# KV_REST_API_READ_ONLY_TOKEN も同時に注入されるが、レート制限はカウンタを
# 書き込むため読み取り専用トークンでは動かない。書き込み可能な方を設定すること。
#
# 未設定の場合はプロセス内のインメモリカウンタにフォールバックし、起動時に
# エラーログを出す。インメモリは Edge のアイソレート間で共有されないため、
# enforce にしても実質的な制限がかからない。本番では必ず設定すること
KV_REST_API_URL=
KV_REST_API_TOKEN=

# x-guard-* 観測ヘッダーを返すためのトークン（任意）
# 設定し、かつ x-guard-debug ヘッダーに同じ値を付けたリクエストにだけ
# 判定結果を返す。誰にでも返すと、遮断されるリスクなしに回避手法
# （どの UA が弾かれるか・どの形状が安いか・しきい値の逆算）を
# 総当たりされるため。通常の観測はサーバーログ側で行う
GUARD_DEBUG_TOKEN=
